{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/schedule-runs",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/schedule-weekly-emails",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/expire-past-due",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/schedule-audits",
      "schedule": "0 5 * * 1"
    }
  ]
}

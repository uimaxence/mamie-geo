# ──────────────────────────────────────────────────────────────────────
# Mamie GEO — variables d'environnement
# ──────────────────────────────────────────────────────────────────────
# Copier en .env.local pour le dev (jamais commité, cf. .gitignore)
# Toutes les valeurs sont validées au démarrage par src/lib/env.ts (Zod).
# Les valeurs préfixées NEXT_PUBLIC_ sont exposées côté client.
# ──────────────────────────────────────────────────────────────────────

# Environnement applicatif
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de données — Neon EU Frankfurt ────────────────────────────────
# Branche perso `dev-{username}` en local (cf. CLAUDE.md § Dev local)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Better Auth ────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Brevo (magic-link + emails transactionnels) ───────────────────────
# Deux backends supportés, le code switch automatiquement selon les
# vars présentes :
#
# Backend 1 — REST API (recommandé en prod Vercel)
#   Avantage : pas d'IP whitelist (le plan Free SMTP Brevo bloque les
#   IPs non whitelistées, et Vercel n'a pas d'IPs fixes).
#   Clé : https://app.brevo.com/settings/keys/api (préfixe xkeysib-)
BREVO_API_KEY=
BREVO_FROM_EMAIL=hello@mamie-geo.fr
BREVO_FROM_NAME=Mamie GEO
#
# ID numérique de la liste Brevo "Newsletter blog". Créer dans
# https://app.brevo.com/contact/list-listing puis copier l'ID. Sert pour :
#   - inscriptions depuis /blog (formulaire BlogNewsletterForm)
#   - notifications à chaque publication d'article (POST /api/blog/notify-publish
#     déclenché par le workflow launchd publication-mamie-geo.sh)
# Si absent : inscriptions échouent gracieusement (UI message) et la notif
# est skip avec un warn log.
BREVO_BLOG_LIST_ID=
#
# Backend 2 — SMTP (legacy, fallback si BREVO_API_KEY absent)
#   Soumis à l'IP whitelist Brevo. BREVO_SMTP_USER est l'identifiant
#   "Connexion" généré par Brevo (forme xxx@smtp-brevo.com), PAS ton
#   email de compte. cf. https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=xxxxxxx@smtp-brevo.com
BREVO_SMTP_PASSWORD=xsmtpsib-...
BREVO_SMTP_FROM="Mamie GEO <hello@mamie-geo.fr>"

# ── LLMs (tracking) — APIs natives, pas OpenRouter ─────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────
# En dev → clés test (sk_test_…, pk_test_…). En prod → clés live.
# STRIPE_WEBHOOK_SECRET : généré par `stripe listen` en local, ou défini
# dans Stripe Dashboard → Developers → Webhooks pour la prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs — un par plan. Les products + prices sont créés dans
# Stripe Dashboard (cf. doc 09 § 2026-05-14). Test mode et live mode ont
# des IDs distincts ; mettre les IDs du mode actif dans .env.local.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ── Cloudflare R2 (storage fichiers) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mamie-geo
R2_PUBLIC_URL=

# ── Upstash Redis (rate-limit) ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── PostHog Cloud EU ───────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ── Cron — secret partagé entre Vercel Cron et /api/cron/dispatch ──────
# Vercel injecte automatiquement Authorization: Bearer ${CRON_SECRET}
# si la variable est nommée CRON_SECRET (cf. vercel.json)
CRON_SECRET=

# ── Admin / interne ────────────────────────────────────────────────────
ADMIN_ALERT_EMAIL=hello@mamie-geo.fr

# ── Google PageSpeed Insights (optionnel) ─────────────────────────────
# Pour /outils/audit-technique. Sans clé : 25K req/jour partagés par IP
# (suffit V0). Avec clé : illimité.
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=

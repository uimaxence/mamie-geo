{
  "name": "mamie-geo",
  "version": "0.0.1",
  "private": true,
  "description": "Mamie GEO — SaaS francophone de Generative Engine Optimization",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "llm:record": "node --import tsx scripts/record-llm-cassette.ts",
    "seed:dev": "node --import tsx scripts/seed-dev.ts",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "smoke:pipeline": "node --import tsx scripts/smoke-test-pipeline.ts",
    "check:metrics": "node --import tsx scripts/check-metrics.ts",
    "test:smtp": "node --import tsx scripts/test-smtp.ts",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "auth:generate": "better-auth-cli generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@google/genai": "^2.4.0",
    "@gsap/react": "^2.1.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@neondatabase/serverless": "^0.10.4",
    "@next/mdx": "^16.2.6",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.57.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.2.7",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.14.0",
    "next": "^15.2.0",
    "nodemailer": "^6.10.0",
    "openai": "^6.38.0",
    "posthog-js": "^1.382.0",
    "posthog-node": "^5.36.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "ws": "^8.20.0"
  }
}
